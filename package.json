{
  "name": "basalt",
  "version": "0.1.0",
  "private": true,
  "description": "Basalt: agente económico autónomo que recibe y propone proyectos, los construye y los monetiza vía x402/USDC, con una capa de gobierno de gasto obligatoria.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "wallet:init": "tsx src/wallet/cli.ts init",
    "wallet:info": "tsx src/wallet/cli.ts info",
    "governance:pending": "tsx src/governance/cli.ts pending",
    "governance:approve": "tsx src/governance/cli.ts approve",
    "governance:reject": "tsx src/governance/cli.ts reject",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@coinbase/x402": "2.1.0",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/express": "2.25.0",
    "@x402/fetch": "2.25.0",
    "ajv": "^8.20.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "franc": "^6.2.0",
    "iban": "^0.0.14",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "turndown": "^7.2.4",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
