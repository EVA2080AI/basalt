# Copiar a .env y ajustar. Nunca commitear el .env real.

# Cifra la clave privada de la wallet en reposo. Sin esto, se guarda en claro
# (solo aceptable para pruebas en testnet).
AUTOMATON_WALLET_PASSPHRASE=

# Gobernanza de gasto (valores por defecto conservadores para testnet)
AUTOMATON_DAILY_CAP_USD=5
AUTOMATON_PER_CALL_CAP_USD=1
AUTOMATON_APPROVAL_THRESHOLD_USD=2

# Debe ponerse en "true" explícitamente para operar en Base mainnet con fondos reales.
AUTOMATON_ALLOW_MAINNET=false

# Precio del primer producto (url-metadata), en USD
AUTOMATON_URL_METADATA_PRICE_USD=0.005

# Facilitator x402 (por defecto el público de x402.org)
AUTOMATON_FACILITATOR_URL=https://x402.org/facilitator

PORT=4021
